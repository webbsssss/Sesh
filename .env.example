# Cloud-Native Platform Engineering: Self-Healing GitOps Pipeline
# Environment Variables
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# AWS Configuration (only needed for EKS/Terraform path)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Or use AWS_PROFILE if using SSO / named profiles:
# AWS_PROFILE=platform-dev

# ---------------------------------------------------------------------------
# Terraform Backend (S3 + DynamoDB for remote state locking)
# ---------------------------------------------------------------------------
TF_STATE_BUCKET=platform-terraform-state
TF_STATE_KEY=dev/eks/terraform.tfstate
TF_LOCK_TABLE=terraform-locks

# ---------------------------------------------------------------------------
# EKS Cluster
# ---------------------------------------------------------------------------
EKS_CLUSTER_NAME=platform-dev
EKS_KUBERNETES_VERSION=1.29

# ---------------------------------------------------------------------------
# Container Registry (ECR or local)
# ---------------------------------------------------------------------------
# For AWS ECR:
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPO=payments-api

# For local kind registry:
# LOCAL_REGISTRY=localhost:5001
# IMAGE_TAG=v1.0.0

# ---------------------------------------------------------------------------
# ArgoCD
# ---------------------------------------------------------------------------
ARGOCD_SERVER=localhost:8080
ARGOCD_USERNAME=admin
# Password is auto-generated; fetch via:
# kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath="{.data.password}" | base64 -d

# ---------------------------------------------------------------------------
# GitOps Repository
# ---------------------------------------------------------------------------
GITOPS_REPO_URL=https://github.com/YOUR_USERNAME/Sesh.git
GITOPS_BRANCH=main

# ---------------------------------------------------------------------------
# Istio / Domain
# ---------------------------------------------------------------------------
ISTIO_INGRESS_HOST=payments.example.com
# TLS certificate name in istio-system namespace:
ISTIO_TLS_SECRET=payments-tls
